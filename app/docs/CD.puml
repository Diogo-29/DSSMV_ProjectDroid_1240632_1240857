@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam linetype ortho
title Diagrama de Classes - ProjectDroid
left to right direction

package "ui" {
    class LoginActivity {
        - authRepository: AuthRepository
        - entrar(): void
        - abrirHome(): void
    }
    class SignupActivity {
        - authRepository: AuthRepository
        - registar(): void
        - dadosValidos(...): boolean
    }
    class HomeActivity {
        - authRepository: AuthRepository
        - abrirLogin(): void
    }
    class CatalogActivity {
        - bookRepository: BookRepository
        - handler: Handler
        - lastSearchId: int
        - nextStartIndex: int
        - isLoading: boolean
        - hasMore: boolean
        - pesquisarTextoEscrito(): void
        - pesquisar(query: String): void
        - carregarPagina(): void
    }
    class BookDetailsActivity {
        - book: Book
        - currentFavorite: Favorite
        - mostrarLivro(): void
        - carregarLivroCompleto(): void
        - verificarDisponibilidade(): void
        - confirmarRequisicao(): void
        - requisitar(): void
        - alternarFavorito(): void
    }
    class MyLoansActivity {
        - showingHistory: boolean
        - carregarEmprestimos(): void
        - devolver(loan: Loan): void
        - renovar(loan: Loan): void
    }
    class FavoritesActivity {
        - carregarFavoritos(): void
    }
    class DailyBookActivity {
        - sensorManager: SensorManager
        - accelerometer: Sensor
        - shakeDetector: ShakeDetector
        - dailyBook: Book
        - shaken: boolean
        - carregarLivroDoDia(): void
        - aoAbanar(): void
        - mostrarLivro(): void
    }
    class BookAdapter
    class LoanAdapter
}

package "repository" {
    interface "RepositoryCallback<T>" as RepositoryCallback {
        + onSuccess(result: T): void
        + onError(message: String): void
    }
    class "ApiCallback<T>" as ApiCallback {
        + onResponse(...): void
        + onFailure(...): void
    }
    class AuthRepository {
        + login(email, password, callback): void
        + register(name, email, password, callback): void
        + logout(): void
        + getCurrentUser(): FirebaseUser
    }
    class BookRepository {
        + searchBooks(query, startIndex, callback): void
        + getBookById(bookId, callback): void
        + getDailyBook(callback): void
    }
    class LoanRepository {
        + {static} LOAN_DAYS = 14
        + {static} MAX_ACTIVE_LOANS = 3
        + {static} getTotalCopies(bookId): int
        + getAvailableCopies(bookId, callback): void
        + getUserLoans(userId, status, callback): void
        + requestLoan(book, userId, callback): void
        + returnLoan(loan, callback): void
        + renewLoan(loan, callback): void
    }
    class FavoriteRepository {
        + getFavorites(userId, callback): void
        + findFavorite(userId, bookId, callback): void
        + addFavorite(book, userId, callback): void
        + removeFavorite(favorite, callback): void
    }
}

package "network" {
    class RetrofitClient {
        + {static} getGoogleBooksApi(): GoogleBooksApi
        + {static} getRestDbApi(): RestDbApi
    }
    interface GoogleBooksApi {
        + searchBooks(q, startIndex, maxResults): Call
        + searchBooks(q, maxResults): Call
        + getBook(id): Call
    }
    interface RestDbApi {
        + getLoans(q): Call
        + createLoan(loan): Call
        + updateLoan(id, changes): Call
        + getFavorites(q): Call
        + addFavorite(favorite): Call
        + deleteFavorite(id): Call
    }
}

package "models" {
    class Book {
        - bookId: String
        - title: String
        - authors: List<String>
        - isbn: String
        - description: String
        - coverUrl: String
        - numberOfPages: Integer
        + getAuthorsAsText(): String
    }
    class Loan {
        - id: String
        - userId: String
        - googleBookId: String
        - loanDate: String
        - dueDate: String
        - returnDate: String
        - status: String
        + isActive(): boolean
    }
    class Favorite {
        - id: String
        - userId: String
        - googleBookId: String
        + toBook(): Book
    }
    class GoogleBooksResponse
}

package "session" {
    class UserSession {
        + {static} getUserId(): String
        + {static} getUserName(): String
        + {static} getUserEmail(): String
    }
}

package "utils" {
    class ShakeDetector {
        - SHAKE_THRESHOLD_G = 2.7
        + onSensorChanged(event): void
    }
    interface OnShakeListener {
        + onShake(): void
    }
    class DateUtils {
        + {static} today(): String
        + {static} addDays(date, days): String
        + {static} isBeforeToday(date): boolean
    }
}

LoginActivity --> AuthRepository
SignupActivity --> AuthRepository
HomeActivity --> AuthRepository
CatalogActivity --> BookRepository
CatalogActivity --> BookAdapter
BookDetailsActivity --> BookRepository
BookDetailsActivity --> LoanRepository
BookDetailsActivity --> FavoriteRepository
MyLoansActivity --> LoanRepository
MyLoansActivity --> LoanAdapter
FavoritesActivity --> FavoriteRepository
FavoritesActivity --> BookAdapter
DailyBookActivity --> BookRepository
DailyBookActivity --> ShakeDetector
ShakeDetector --> OnShakeListener

BookRepository --> GoogleBooksApi
LoanRepository --> RestDbApi
FavoriteRepository --> RestDbApi
ApiCallback --> RepositoryCallback : notifica >
RetrofitClient ..> GoogleBooksApi : cria >
RetrofitClient ..> RestDbApi : cria >

BookRepository ..> Book
BookRepository ..> GoogleBooksResponse
LoanRepository ..> Loan
FavoriteRepository ..> Favorite
LoanRepository ..> DateUtils
BookDetailsActivity ..> UserSession
MyLoansActivity ..> UserSession
FavoritesActivity ..> UserSession
@enduml
