@startuml
title UC2 - Consultar detalhes de um livro (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":CatalogActivity\n:FavoritesActivity\n:DailyBookActivity" as P
participant ":BookDetailsActivity" as A
participant ":BookRepository" as BR
participant ":LoanRepository" as LR
participant ":FavoriteRepository" as FR
participant "Google Books API" as GB <<externo>>
participant "RestDB" as DB <<externo>>

U -> P: clica num livro
P -> A: startActivity(intent + EXTRA_BOOK)
activate A
A -> A: book = getSerializableExtra(EXTRA_BOOK)
A -> A: mostrarLivro()
opt book sem descrição nem páginas (vem dos favoritos)
  A -> BR: getBookById(bookId, callback)
  activate BR
  BR -> GB: GET /volumes/{id}
  GB --> BR: 200 OK (Item)
  BR --> A: onSuccess(Book completo)
  deactivate BR
  A -> A: book = fullBook; mostrarLivro()
end
A -> A: verificarDisponibilidade()
A -> LR: getTotalCopies(bookId)
LR --> A: total (1..5)
A -> LR: getAvailableCopies(bookId, callback)
activate LR
LR -> DB: GET /loans?q={"googleBookId":id,"status":"ATIVO"}
DB --> LR: 200 OK (List<Loan>)
LR --> A: onSuccess(total - ativos)
deactivate LR
A -> A: "X de Y exemplares disponíveis"\n(btnRequestLoan ativo se X > 0)
A -> A: verificarFavorito()
A -> FR: findFavorite(userId, bookId, callback)
activate FR
FR -> DB: GET /favorites?q={"userId":uid,"googleBookId":id}
DB --> FR: 200 OK (List<Favorite>)
FR --> A: onSuccess(favorito ou null)
deactivate FR
A -> A: atualizarBotaoFavorito()
A --> U: mostra os detalhes
deactivate A
@enduml
