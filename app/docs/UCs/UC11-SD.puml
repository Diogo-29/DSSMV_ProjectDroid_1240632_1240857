@startuml
title UC11 - Terminar sessão (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":HomeActivity" as H
participant ":AuthRepository" as R
participant "Firebase Auth" as FA <<externo>>
participant ":LoginActivity" as L

U -> H: clica em "Terminar sessão"
activate H
H -> R: logout()
activate R
R -> FA: signOut()
deactivate R
H -> H: abrirLogin()
H -> L: startActivity(FLAG_NEW_TASK | FLAG_CLEAR_TASK)
H -> H: finish()
deactivate H
L --> U: ecrã de login\n(o botão "voltar" já não regressa à Home)
@enduml
