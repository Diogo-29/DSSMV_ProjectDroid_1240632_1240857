@startuml
title UC1 - Listar livros (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":CatalogActivity" as A
participant ":BookRepository" as R
participant ":GoogleBooksApi" as API
participant "Google Books API" as GB <<externo>>
participant ":BookAdapter" as AD

U -> A: abre o Catálogo
activate A
A -> A: onCreate()
A -> A: pesquisar("subject:fiction")
A -> A: searchId = ++lastSearchId\nprogressSearch VISIBLE
A -> R: searchBooks(query, callback)
activate R
R -> API: searchBooks(query).enqueue()
activate API
API -> GB: GET /volumes?q=subject:fiction&key=...
GB --> API: 200 OK (JSON)
API --> R: onResponse(GoogleBooksResponse)
deactivate API
R -> R: converterLista(response)
R --> A: onSuccess(List<Book>)
deactivate R
A -> A: books.clear(); books.addAll(result)
A -> AD: notifyDataSetChanged()
A --> U: mostra a lista de livros
deactivate A
@enduml
