@startuml
title UC6 - Consultar empréstimos ativos (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":HomeActivity" as H
participant ":MyLoansActivity" as A
participant ":UserSession" as S
participant ":LoanRepository" as R
participant "RestDB" as DB <<externo>>
participant ":LoanAdapter" as AD

U -> H: clica em "Os meus empréstimos"
H -> A: startActivity()
activate A
A -> A: onResume()
A -> A: carregarEmprestimos()\n(showingHistory = false)
A -> S: getUserId()
S --> A: uid
A -> R: getUserLoans(uid, "ATIVO", callback)
activate R
R -> DB: GET /loans?q={"userId":uid,"status":"ATIVO"}
DB --> R: 200 OK (List<Loan>)
R --> A: onSuccess(List<Loan>)
deactivate R
A -> AD: notifyDataSetChanged()
AD -> AD: onBindViewHolder(): "Devolver até <data>"\n+ " (em atraso)" se dueDate < hoje
A --> U: mostra os empréstimos ativos
deactivate A
@enduml
