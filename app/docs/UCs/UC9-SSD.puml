@startuml
title UC9 - Criar conta (SSD)

actor "Utilizador" as U
participant ":Sistema" as S

U -> S: abrirRegisto()
activate S
S --> U: formulário (nome, email, password, confirmar password)
deactivate S
U -> S: criarConta(nome, email, password, confirmacao)
activate S
alt dados válidos e email ainda não registado
  S --> U: "Conta criada com sucesso!" + ecrã principal
else dados inválidos ou erro
  S --> U: mensagemDeErro
end
deactivate S
@enduml
