@startuml
title UC7 - Consultar histórico de empréstimos (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":MyLoansActivity" as A
participant ":UserSession" as S
participant ":LoanRepository" as R
participant "RestDB" as DB <<externo>>
participant ":LoanAdapter" as AD

U -> A: clica em "Histórico"
activate A
A -> A: showingHistory = true
A -> A: carregarEmprestimos()
A -> S: getUserId()
S --> A: uid
A -> R: getUserLoans(uid, "DEVOLVIDO", callback)
activate R
R -> DB: GET /loans?q={"userId":uid,"status":"DEVOLVIDO"}
DB --> R: 200 OK (List<Loan>)
R --> A: onSuccess(List<Loan>)
deactivate R
A -> AD: notifyDataSetChanged()
AD -> AD: onBindViewHolder(): "Devolvido em <data>"
A --> U: mostra o histórico
deactivate A
@enduml
