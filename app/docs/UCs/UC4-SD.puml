@startuml
title UC4 - Requisitar livro (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":BookDetailsActivity" as A
participant ":AlertDialog" as D
participant ":UserSession" as S
participant ":LoanRepository" as R
participant "RestDB" as DB <<externo>>

U -> A: clica em "Requisitar"
activate A
A -> A: confirmarRequisicao()
A -> D: show(título, prazo 14 dias, data limite)
deactivate A
U -> D: clica em "Requisitar"
D -> A: requisitar()
activate A
A -> A: btnRequestLoan.setEnabled(false)
A -> S: getUserId()
S --> A: uid
A -> R: requestLoan(book, uid, callback)
activate R
R -> DB: GET /loans?q={"status":"ATIVO"}
DB --> R: 200 OK (List<Loan>)
R -> R: conta empréstimos ativos\ndo livro e do utilizador
alt utilizador já tem este livro
  R --> A: onError("Já tens este livro requisitado.")
else ativos do livro >= getTotalCopies(bookId)
  R --> A: onError("Não há exemplares disponíveis deste livro.")
else utilizador já tem 3 empréstimos ativos
  R --> A: onError("Já tens 3 empréstimos ativos...")
else regras cumpridas
  R -> R: createLoan(): new Loan(..., hoje, hoje + 14, "ATIVO")
  R -> DB: POST /loans (JSON)
  DB --> R: 201 Created (Loan)
  R --> A: onSuccess(loan)
  A --> U: Toast "Livro requisitado! Devolver até <data>"
  A -> A: finish()
end
deactivate R
deactivate A
@enduml
