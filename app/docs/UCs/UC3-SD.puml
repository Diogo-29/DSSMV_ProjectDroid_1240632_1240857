@startuml
title UC3 - Pesquisar livros (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":CatalogActivity" as A
participant ":Handler" as H
participant ":BookRepository" as R
participant "Google Books API" as GB <<externo>>

loop por cada letra escrita
  U -> A: escreve uma letra
  activate A
  A -> A: afterTextChanged()
  A -> H: removeCallbacks(searchRunnable)
  A -> H: postDelayed(searchRunnable, 500 ms)
  deactivate A
end
note over U, H: o utilizador para de escrever durante 500 ms
H -> A: pesquisarTextoEscrito()
activate A
alt texto com 3 ou mais letras
  A -> A: pesquisar(texto)
else texto vazio
  A -> A: pesquisar("subject:fiction")
end
A -> A: searchId = ++lastSearchId
A -> R: searchBooks(texto, callback)
activate R
R -> GB: GET /volumes?q=<texto>
GB --> R: 200 OK (JSON)
R --> A: onSuccess(List<Book>)
deactivate R
alt searchId == lastSearchId
  A -> A: atualiza a lista\n(textEmpty visível se vazia)
  A --> U: mostra os resultados
else resposta de uma pesquisa antiga
  A -> A: ignora a resposta
end
deactivate A
@enduml
