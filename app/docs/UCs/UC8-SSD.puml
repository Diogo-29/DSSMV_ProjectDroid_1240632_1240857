@startuml
title UC8 - Ver o livro do dia (SSD)

actor "Utilizador" as U
participant ":Sistema" as S

U -> S: abrirLivroDoDia()
activate S
S --> U: "Abana o telemóvel para descobrir o livro do dia!"
deactivate S
U -> S: abanarTelemovel()
activate S
S --> U: livroDoDia (capa, título, autores) + vibração
deactivate S
opt
  U -> S: verDetalhes()
  activate S
  S --> U: detalhes do livro (UC2)
  deactivate S
end
@enduml
