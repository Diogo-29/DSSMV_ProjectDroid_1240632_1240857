@startuml
title UC9 - Criar conta (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":SignupActivity" as A
participant ":AuthRepository" as R
participant "Firebase Auth" as FA <<externo>>
participant ":HomeActivity" as H

U -> A: preenche nome, email, password, confirmação\ne clica em "Criar conta"
activate A
A -> A: registar()
A -> A: dadosValidos(...)
alt dados inválidos (vazio, email inválido, password < 6, passwords diferentes)
  A --> U: setError() no campo respetivo
else dados válidos
  A -> A: btnSignup.setEnabled(false)
  A -> R: register(nome, email, password, callback)
  activate R
  R -> FA: createUserWithEmailAndPassword(email, password)
  alt conta criada
    FA --> R: onSuccess(AuthResult)
    R -> FA: user.updateProfile(displayName = nome)
    FA --> R: onComplete
    R --> A: onSuccess(FirebaseUser)
    A -> H: startActivity(FLAG_NEW_TASK | FLAG_CLEAR_TASK)
    A -> A: finish()
    H --> U: ecrã principal "Olá, <nome>"
  else erro (email já existe, password fraca, sem rede)
    FA --> R: onFailure(exception)
    R -> R: traduzirErro(exception)
    R --> A: onError(mensagem em português)
    A --> U: Toast(mensagem)
  end
  deactivate R
end
deactivate A
@enduml
