@startuml
title UC3 - Pesquisar livros (SSD)

actor "Utilizador" as U
participant ":Sistema" as S

U -> S: escreverPesquisa(texto)
activate S
alt texto com 3 ou mais letras
  S --> U: listaDeResultados
else texto vazio
  S --> U: listaInicial
end
alt sem resultados
  S --> U: "Nenhum resultado encontrado."
end
deactivate S
@enduml
