@startuml
title UC8 - Ver o livro do dia (SD)
skinparam sequenceMessageAlign left

actor "Utilizador" as U
participant ":DailyBookActivity" as A
participant ":SensorManager" as SM
participant ":ShakeDetector" as SD
participant ":BookRepository" as R
participant "Google Books API" as GB <<externo>>

U -> A: clica em "Livro do dia"
activate A
A -> A: onCreate()
A -> SM: getDefaultSensor(TYPE_ACCELEROMETER)
SM --> A: accelerometer
A -> SD: new ShakeDetector(this::aoAbanar)
A -> R: getDailyBook(callback)
activate R
R -> R: seed = data de hoje (ex.: 20261030)\nrandom = new Random(seed)\ntema = TEMAS[random.nextInt(10)]\nposicao = random.nextInt(20)
R -> GB: GET /volumes?q=subject:<tema>&maxResults=20
GB --> R: 200 OK (JSON)
R --> A: onSuccess(livros[posicao % tamanho])
deactivate R
A -> A: dailyBook = livro
A -> A: onResume()
A -> SM: registerListener(shakeDetector, accelerometer, SENSOR_DELAY_UI)
A --> U: "Abana o telemóvel para descobrir o livro do dia!"
deactivate A

U -> SM: abana o telemóvel
loop enquanto o sensor envia valores
  SM -> SD: onSensorChanged(event)
  activate SD
  SD -> SD: gForce = sqrt(x² + y² + z²) / 9.8
  opt gForce > 2.7 e passou mais de 1 s desde o último abanão
    SD -> A: onShake() -> aoAbanar()
    activate A
    A -> A: shaken = true
    A -> SM: unregisterListener(shakeDetector)
    A -> A: performHapticFeedback() (vibração)
    alt dailyBook já chegou
      A -> A: mostrarLivro()
      A --> U: mostra capa, título e autores
    else ainda a carregar
      A --> U: "A carregar o livro do dia..."\n(mostrado quando a resposta chegar)
    end
    deactivate A
  end
  deactivate SD
end
@enduml
